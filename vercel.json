{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,media/**,staticfiles/**,db.sqlite3,**/__pycache__/**,**/tests.py}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/cron/tick/", "schedule": "0 6 * * *" }]
}
