# Copy to .env for local development. On the host, set these as environment variables.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# Public https address of the app. Instagram downloads media from here.
SITE_URL=http://localhost:8000
TIME_ZONE=Europe/Athens

STUDIO_NAME=Our Dance Studio
STUDIO_VOICE=Warm, energetic and welcoming. We teach all ages and levels. Use a few relevant emojis.

# Meta app → Instagram → API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Accounts. These emails become owners automatically when they sign up (comma separated).
# If empty, the first account created becomes the owner.
OWNER_EMAILS=you@example.com

# Optional: "Continue with Google" (Google Cloud Console → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: real email sending (password resets, new-member alerts). Without it, emails print to the console.
# Gmail: smtp.gmail.com + an App Password (Google Account → Security → App passwords)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional: enables AI captions (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Postgres instead of SQLite, e.g. postgres://user:pass@host:5432/db
# DATABASE_URL=
# Optional: where uploads are stored (point at a persistent disk in production)
# MEDIA_ROOT=/var/data/media

# Only for deploying to Vercel from this Mac (https://vercel.com/account/tokens)
VERCEL_TOKEN=
